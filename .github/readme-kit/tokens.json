{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "VOANEVES readme-kit tokens: README logo and buttons, author mark, landing page. Generated by scripts/readme-kit/build.py and gated by dtcg-contrast.",
  "page": {
    "$type": "color",
    "$description": "GitHub page background.",
    "$value": "#ffffff",
    "$extensions": {
      "vn": {
        "dark": "#0d1117"
      }
    }
  },
  "button": {
    "$type": "color",
    "primary": {
      "fill": {
        "$value": "#0a0a0a",
        "$extensions": {
          "vn": {
            "dark": "#e8dec5"
          }
        }
      },
      "text": {
        "$value": "#f4ead4",
        "$extensions": {
          "vn": {
            "dark": "#0a0a0a"
          }
        }
      },
      "signal": {
        "$value": "#ff3838",
        "$extensions": {
          "vn": {
            "dark": "#b80000"
          }
        }
      }
    },
    "secondary": {
      "fill": {
        "$value": "#f4ead4",
        "$extensions": {
          "vn": {
            "dark": "#1c1a17"
          }
        }
      },
      "text": {
        "$value": "#0a0a0a",
        "$extensions": {
          "vn": {
            "dark": "#e8dec5"
          }
        }
      },
      "border": {
        "$value": "#0a0a0a",
        "$extensions": {
          "vn": {
            "dark": "#8a816f"
          }
        }
      }
    },
    "command": {
      "prompt": {
        "$value": "#b80000",
        "$extensions": {
          "vn": {
            "dark": "#ff5a5a"
          }
        }
      }
    }
  },
  "logo": {
    "$type": "color",
    "ink": {
      "$value": "#0a0a0a"
    },
    "paper": {
      "$value": "#f4ead4"
    },
    "ring": {
      "$value": "#0a0a0a",
      "$extensions": {
        "vn": {
          "dark": "#e8dec5"
        }
      }
    },
    "signal": {
      "$value": "#d70000"
    }
  },
  "duo": {
    "$type": "color",
    "$description": "Author mark visible on both light and dark pages.",
    "disc": {
      "$value": "#0a0a0a"
    },
    "ring": {
      "$value": "#e8dec5"
    },
    "glyph": {
      "$value": "#f4ead4"
    },
    "signal": {
      "$value": "#f50000"
    }
  },
  "landing": {
    "$type": "color",
    "surface": {
      "$value": "#f4ead4",
      "$extensions": {
        "vn": {
          "dark": "#121110"
        }
      }
    },
    "surfaceAlt": {
      "$value": "#e8dec5",
      "$extensions": {
        "vn": {
          "dark": "#1c1a17"
        }
      }
    },
    "text": {
      "$value": "#0a0a0a",
      "$extensions": {
        "vn": {
          "dark": "#f4ead4"
        }
      }
    },
    "muted": {
      "$value": "#4a4437",
      "$extensions": {
        "vn": {
          "dark": "#b8ae98"
        }
      }
    },
    "link": {
      "$value": "#b80000",
      "$extensions": {
        "vn": {
          "dark": "#ff5a5a"
        }
      }
    },
    "focus": {
      "$value": "#b80000",
      "$extensions": {
        "vn": {
          "dark": "#ff5a5a"
        }
      }
    }
  }
}
